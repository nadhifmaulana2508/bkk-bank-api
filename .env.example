APP_ENV=local

# Production: set APP_ENV_FILE pada environment web server ke file di luar
# document root, lalu isi secret di file tersebut.
SSO_JWT_SECRET=ganti-dengan-random-minimal-32-karakter
CORS_ALLOWED_ORIGINS=http://localhost
# Login web dan akses Swagger memakai user_sso, bukan static access code.

# Aktifkan setelah tabel api_applications dibuat dan token setiap aplikasi
# sudah didaftarkan. Jangan menaruh token aplikasi di source code.
APP_TOKEN_REQUIRED=false

# Optional dedicated Base64 key 32 byte for app-token vault encryption.
# If blank, the key is derived with HKDF from a strong SSO_JWT_SECRET.
# APP_ENV=local/development can use a persistent key file under ignored storage/.
# Generate with: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_TOKEN_ENCRYPTION_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nama_database
DB_USER=nama_user
DB_PASS=password_database

# Database Bank API NORA. Host/user/pass memakai DB_* di atas jika tidak diisi.
BANK_API_DB_NAME=db_bank_api
BANK_API_BRANCH_DB_NAME=dpk

SMTP_HOST=smtp.example.com
SMTP_USER=helpdesk@example.com
SMTP_PASS=password_smtp
SMTP_PORT=587
SMTP_ENCRYPTION=tls
