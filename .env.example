APP_ENV=local

# Production: set APP_ENV_FILE pada environment web server ke file di luar
# document root, lalu isi secret di file tersebut.
SSO_JWT_SECRET=ganti-dengan-random-minimal-32-karakter
CORS_ALLOWED_ORIGINS=http://localhost
# Login web dan akses Swagger memakai user_sso, bukan static access code.

# Aktifkan setelah tabel api_applications dibuat dan token setiap aplikasi
# sudah didaftarkan. Jangan menaruh token aplikasi di source code.
APP_TOKEN_REQUIRED=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nama_database
DB_USER=nama_user
DB_PASS=password_database

SMTP_HOST=smtp.example.com
SMTP_USER=helpdesk@example.com
SMTP_PASS=password_smtp
SMTP_PORT=587
SMTP_ENCRYPTION=tls
