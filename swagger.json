{
  "openapi": "3.0.0",
  "info": {
    "title": "SSO API BKK",
    "version": "1.0.0",
    "description": "SSO API untuk SIMPEG, MONBIS, dll (JWT Based)"
  },
  "servers": [
    {
      "url": "http://localhost/rest_api_sso",
      "description": "Local Dev"
    },
    {
      "url": "https://devsso.bkkjateng.co.id",
      "description": "Development SSO"
    },
    {
      "url": "https://apisso.bkkjateng.co.id",
      "description": "Production SSO"
    }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "summary": "Login menggunakan id_peg + password",
        "tags": ["Auth"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["id_peg", "password"],
                "properties": {
                  "id_peg": {
                    "type": "string",
                    "example": "102-119",
                    "description": "ID pegawai"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 6,
                    "example": "<PASSWORD_PEGAWAI>"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login berhasil",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "Login berhasil",
                  "data": {
                    "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                  }
                }
              }
            }
          },
          "401": {
            "description": "ID pegawai atau password salah"
          },
          "400": {
            "description": "ID pegawai dan password wajib valid, password minimal 6 karakter"
          },
          "403": {
            "description": "Aplikasi belum terdaftar atau token aplikasi tidak valid"
          }
        }
      }
    },
    "/api/auth/whoami": {
      "get": {
        "summary": "Ambil data user dari token (Bearer)",
        "tags": ["Auth"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": [],
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Data user",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "OK",
                  "data": {
                    "employee_id": "102-119",
                    "full_name": "Nama Pegawai",
                    "branch_name": "Kantor Cabang",
                    "job_position": "Staff"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token tidak valid / expired"
          }
        }
      },
      "post": {
        "summary": "Ambil data user dari token (Body JSON)",
        "security": [
          {
            "appTokenAuth": [],
            "appCode": []
          }
        ],
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token"],
                "properties": {
                  "token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Data user"
          },
          "401": {
            "description": "Token tidak valid / expired"
          }
        }
      }
    },
    "/api/auth/change-password": {
      "post": {
        "summary": "Ganti Password (Perlu Login)",
        "tags": ["Profile"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": [],
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["old_password", "new_password"],
                "properties": {
                  "old_password": {
                    "type": "string",
                    "minLength": 6,
                    "example": "<PASSWORD_PEGAWAI>"
                  },
                  "new_password": {
                    "type": "string",
                    "minLength": 6,
                    "maxLength": 255,
                    "example": "BkkBaru2026!",
                    "description": "Password baru minimal 6 karakter"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password berhasil diubah"
          },
          "400": {
            "description": "Password lama salah atau password baru minimal 6 karakter"
          },
          "401": {
            "description": "Token tidak valid / expired"
          }
        }
      }
    },
    "/api/auth/update-profile": {
      "post": {
        "summary": "Update Email atau Nomor Telp (Perlu Login)",
        "tags": ["Profile"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": [],
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "pegawai_bkk@gmail.com"
                  },
                  "telp": {
                    "type": "string",
                    "example": "081234567890"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Data Profil berhasil diperbarui!"
          },
          "400": {
            "description": "Minimal kirim email atau telp"
          },
          "401": {
            "description": "Token tidak valid / expired"
          }
        }
      }
    },
    "/api/auth/forgot-password": {
      "post": {
        "summary": "Kirim OTP Reset Password ke Email",
        "tags": ["Reset Password"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "pegawai_bkk@gmail.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Kode OTP berhasil dikirim, mengembalikan otp_token sementara"
          },
          "400": {
            "description": "Email wajib diisi"
          },
          "404": {
            "description": "Email tidak terdaftar di sistem"
          },
          "500": {
            "description": "Gagal mengirim email OTP (Error Mailer)"
          }
        }
      }
    },
    "/api/auth/resend-otp": {
      "post": {
        "summary": "Kirim ulang OTP Reset Password ke Email",
        "description": "Gunakan endpoint ini jika OTP sebelumnya belum diterima atau sudah kadaluarsa. Token OTP baru akan dikembalikan.",
        "tags": ["Reset Password"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "pegawai_bkk@gmail.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP baru berhasil dikirim, mengembalikan otp_token sementara"
          },
          "400": {
            "description": "Email wajib diisi"
          },
          "404": {
            "description": "Email tidak terdaftar di sistem"
          },
          "500": {
            "description": "Gagal mengirim email OTP (Error Mailer atau akun SMTP suspended)"
          }
        }
      }
    },
    "/api/auth/verify-otp": {
      "post": {
        "summary": "Verifikasi Kode OTP dari Email",
        "tags": ["Reset Password"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["otp_token", "otp_code"],
                "properties": {
                  "otp_token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIs...",
                    "description": "Token yang didapat dari response /forgot-password atau /resend-otp"
                  },
                  "otp_code": {
                    "type": "string",
                    "example": "123456",
                    "description": "6 digit kode OTP dari email"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP Valid, mengembalikan reset_token"
          },
          "400": {
            "description": "Kode OTP salah"
          },
          "401": {
            "description": "Sesi OTP tidak valid atau sudah kadaluarsa (lebih dari 5 menit)"
          }
        }
      }
    },
    "/api/auth/reset-password": {
      "post": {
        "summary": "Aksi Ubah Password via Reset Token",
        "tags": ["Reset Password"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["reset_token", "new_password"],
                "properties": {
                  "reset_token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIs...",
                    "description": "Token yang didapat dari response /verify-otp"
                  },
                  "new_password": {
                    "type": "string",
                    "minLength": 6,
                    "maxLength": 255,
                    "example": "BkkBaru2026!",
                    "description": "Password baru minimal 6 karakter"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password berhasil di-reset"
          },
          "400": {
            "description": "Token reset wajib diisi dan password baru minimal 6 karakter"
          },
          "401": {
            "description": "Sesi reset password tidak valid atau sudah kadaluarsa (lebih dari 15 menit)"
          }
        }
      }
    },
    "/api/simpeg/ao/list": {
      "get": {
        "summary": "Ambil daftar AO SIMPEG berdasarkan type_ao dan kode kantor",
        "description": "Jika kode_kantor bernilai 000, data AO diambil dari kantor 001 sampai 028.",
        "tags": ["SIMPEG"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": [],
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "type_ao",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["dana", "kredit", "remedial"]
            },
            "description": "Jenis Account Officer: dana, kredit, atau remedial"
          },
          {
            "in": "query",
            "name": "kode_kantor",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Kode kantor. Gunakan 000 untuk mengambil AO dari kantor 001 sampai 028.",
            "example": "000"
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil mengambil data AO",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "Berhasil mengambil data AO DANA",
                  "data": [
                    {
                      "employee_id": "123-456",
                      "full_name": "Syaifun Nadhif Maulana",
                      "kode_cabang": "000",
                      "branch_name": "Kantor Pusat",
                      "job_position": "AO Dana"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Parameter 'type_ao' atau kode kantor wajib diisi; type_ao harus dana, kredit, atau remedial"
          },
          "401": {
            "description": "Token tidak valid / expired"
          }
        }
      }
    },
    "/api/simpeg/pegawai/search": {
      "get": {
        "summary": "Cari data pegawai berdasarkan id_peg atau nama",
        "description": "Cari pegawai berdasarkan id_peg atau sebagian nama. Endpoint memakai app token dan mengembalikan field ringkas yang konsisten dengan whoami.",
        "tags": ["SIMPEG"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "id_peg",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "ID pegawai yang ingin dicari",
            "example": "102-119"
          },
          {
            "in": "query",
            "name": "nama",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Sebagian atau seluruh nama pegawai",
            "example": "Nama Pegawai"
          }
        ],
        "responses": {
          "200": {
            "description": "Data pegawai ditemukan",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "OK",
                  "data": [
                    {
                      "employee_id": "102-119",
                      "full_name": "Nama Pegawai",
                      "kode": "001",
                      "job_position": "Staf"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Minimal salah satu parameter id_peg atau nama wajib diisi"
          }
        }
      }
    },
    "/api/v1/simontok/credit-accounts": {
      "get": {
        "summary": "Cari rekening berdasarkan nomor rekening atau nama nasabah",
        "description": "Nomor rekening dikembalikan sebagai string. Pencarian nama dapat menghasilkan beberapa rekening dan tidak memilih nasabah secara otomatis.",
        "tags": ["SIMONTOK"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": [],
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 100
            },
            "description": "Nomor rekening atau nama nasabah. Minimal 3 karakter.",
            "example": "001135000004"
          },
          {
            "in": "query",
            "name": "branch_code",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{3}$"
            },
            "description": "Kode cabang resmi. User cabang hanya dapat memakai cabangnya sendiri.",
            "example": "001"
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            },
            "description": "Jumlah maksimum hasil.",
            "example": 20
          }
        ],
        "responses": {
          "200": {
            "description": "Daftar rekening ditemukan",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "OK",
                  "data": [
                    {
                      "account_id": "MDAxADAwMTEzNTAwMDAwNA",
                      "account_number": "001135000004",
                      "customer_id": "CORE-CUSTOMER-456",
                      "customer_name": "Nama Nasabah",
                      "branch": {
                        "code": "001",
                        "name": "Kantor Cabang Contoh",
                        "is_active": true
                      },
                      "selectable": true
                    }
                  ],
                  "meta": {
                    "limit": 20,
                    "count": 1
                  }
                }
              }
            }
          },
          "400": {
            "description": "Parameter pencarian tidak valid"
          },
          "401": {
            "description": "Token user tidak ada atau tidak valid"
          },
          "403": {
            "description": "User tidak boleh mengakses cabang yang diminta"
          }
        }
      }
    },
    "/api/v1/simontok/credit-accounts/{account_id}": {
      "get": {
        "summary": "Ambil detail rekening, nasabah, kredit, dan seluruh agunan",
        "tags": ["SIMONTOK"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": [],
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identifier stabil yang dikembalikan oleh endpoint pencarian.",
            "example": "MDAxADAwMTEzNTAwMDAwNA"
          }
        ],
        "responses": {
          "200": {
            "description": "Detail rekening ditemukan",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "OK",
                  "data": {
                    "account_id": "MDAxADAwMTEzNTAwMDAwNA",
                    "account_number": "001135000004",
                    "customer": {
                      "customer_id": "CORE-CUSTOMER-456",
                      "name": "Nama Nasabah"
                    },
                    "branch": {
                      "code": "001",
                      "name": "Kantor Cabang Contoh",
                      "is_active": true
                    },
                    "credit": {
                      "loan_amount": "100000000.00",
                      "realization_date": "2026-11-03"
                    },
                    "collaterals": []
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token user tidak ada atau tidak valid"
          },
          "404": {
            "description": "Rekening tidak ditemukan"
          }
        }
      }
    },
    "/api/v1/simontok/credit-accounts/{account_id}/collaterals": {
      "get": {
        "summary": "Ambil seluruh agunan rekening",
        "description": "Satu rekening dapat memiliki beberapa agunan. Semua agunan yang terhubung dikembalikan sebagai array.",
        "tags": ["SIMONTOK"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": [],
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identifier rekening dari endpoint pencarian.",
            "example": "MDAxADAwMTEzNTAwMDAwNA"
          }
        ],
        "responses": {
          "200": {
            "description": "Daftar agunan ditemukan",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "OK",
                  "data": [
                    {
                      "collateral_id": "CORE-COLLATERAL-789",
                      "collateral_code": "AG-000123",
                      "type_code": "TANAH_BANGUNAN",
                      "type_name": "Tanah dan Bangunan",
                      "description": "Deskripsi agunan",
                      "legal_reference": "SHM-123",
                      "value": "100000000.00",
                      "account_id": "MDAxADAwMTEzNTAwMDAwNA"
                    }
                  ],
                  "meta": {
                    "count": 1
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token user tidak ada atau tidak valid"
          },
          "404": {
            "description": "Rekening tidak ditemukan"
          }
        }
      }
    },
    "/api/v1/simontok/branches": {
      "get": {
        "summary": "Ambil master cabang aktif",
        "description": "Master cabang dibaca dari database DPK dan tidak mengekspos nama tabel database kepada SIMONTOK.",
        "tags": ["SIMONTOK"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "active",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            },
            "description": "true untuk hanya cabang aktif, false untuk semua cabang.",
            "example": true
          }
        ],
        "responses": {
          "200": {
            "description": "Master cabang ditemukan",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "OK",
                  "data": [
                    {
                      "code": "001",
                      "name": "Kantor Cabang Contoh",
                      "is_active": true
                    }
                  ],
                  "meta": {
                    "count": 1
                  }
                }
              }
            }
          },
          "401": {
            "description": "App dan X-App-Token wajib diisi"
          },
          "403": {
            "description": "Token aplikasi tidak valid atau tidak aktif"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "appTokenAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-App-Token",
        "description": "Token aplikasi. Kirim juga header App dengan kode aplikasi, misalnya simpeg."
      },
      "appCode": {
        "type": "apiKey",
        "in": "header",
        "name": "App",
        "description": "Kode aplikasi yang terdaftar, misalnya simpeg."
      }
    }
  }
}
