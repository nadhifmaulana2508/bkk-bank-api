  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "appTokenAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-App-Token",
        "description": "Token aplikasi. Kirim juga header App dengan kode aplikasi, misalnya simpeg."
      },
      "appCode": {
        "type": "apiKey",
        "in": "header",
        "name": "App",
        "description": "Kode aplikasi yang terdaftar, misalnya simpeg."
      }
    }
  }
