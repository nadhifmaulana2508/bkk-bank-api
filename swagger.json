{
  "openapi": "3.0.0",
  "info": {
    "title": "SSO API BKK",
    "version": "1.0.0",
    "description": "SSO API untuk SIMPEG, MONBIS, dll (JWT Based)"
  },
  "servers": [
    {
      "url": "http://localhost/bank-api",
      "description": "Local Dev"
    },
    {
      "url": "https://devsso.bkkjateng.co.id",
      "description": "Development SSO"
    },
    {
      "url": "https://apisso.bkkjateng.co.id",
      "description": "Production SSO"
    }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "summary": "Login menggunakan id_peg + password",
        "tags": ["Auth"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["id_peg", "password"],
                "properties": {
                  "id_peg": {
                    "type": "string",
                    "example": "102-119",
                    "description": "ID pegawai"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 6,
                    "example": "<PASSWORD_PEGAWAI>"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login berhasil",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "Login berhasil",
                  "data": {
                    "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                  }
                }
              }
            }
          },
          "401": {
            "description": "ID pegawai atau password salah"
          },
          "400": {
            "description": "ID pegawai dan password wajib valid, password minimal 6 karakter"
          },
          "403": {
            "description": "Aplikasi belum terdaftar atau token aplikasi tidak valid"
          }
        }
      }
    },
    "/api/auth/login-dummy": {
      "post": {
        "summary": "Login dummy untuk pengujian local/development",
        "description": "Tersedia pada APP_ENV=local dari localhost atau APP_ENV=development dengan SSO_DUMMY_AUTH_ENABLED=true, SSO_DUMMY_PASSWORD, dan SSO_DUMMY_ALLOWED_IPS berisi IP penguji. Production selalu menolak endpoint ini. Gunakan akun pegawai dengan status login dan jabatan aktif; password akun tb_apk tidak diubah. Wajib memakai App dan X-App-Token aplikasi aktif yang terdaftar.",
        "tags": ["Dummy"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["id_peg", "password"],
                "properties": {
                  "id_peg": {
                    "type": "string",
                    "maxLength": 12,
                    "example": "102-119"
                  },
                  "password": {
                    "type": "string",
                    "example": "<SSO_DUMMY_PASSWORD>"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login dummy berhasil",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "Login berhasil",
                  "data": {
                    "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                  }
                }
              }
            }
          },
          "400": {
            "description": "ID pegawai atau password dummy tidak valid"
          },
          "401": {
            "description": "Kredensial dummy salah atau akun tidak memenuhi syarat"
          },
          "403": {
            "description": "App dan X-App-Token tidak valid atau tidak aktif"
          },
          "404": {
            "description": "Endpoint dinonaktifkan, bukan environment yang diizinkan, atau IP tidak di-allowlist"
          },
          "503": {
            "description": "Password dummy belum dikonfigurasi di environment development"
          }
        }
      }
    },
    "/api/auth/auth-dummy": {
      "get": {
        "summary": "Ambil profil dari token dummy (Bearer)",
        "description": "Mengembalikan profil dan jabatan aktif untuk token login-dummy. Hanya aktif di local dari localhost atau di development dengan IP allowlist; production menolak endpoint ini.",
        "tags": ["Dummy"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": [],
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Data pegawai",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "OK",
                  "data": {
                    "employee_id": "102-119",
                    "full_name": "Nama Pegawai",
                    "branch_name": "Kantor Cabang",
                    "job_position": "Staff"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token dummy tidak valid atau kedaluwarsa"
          },
          "403": {
            "description": "Token tidak sesuai aplikasi atau akun tidak aktif"
          },
          "404": {
            "description": "Endpoint dinonaktifkan, bukan environment yang diizinkan, atau IP tidak di-allowlist"
          }
        }
      },
      "post": {
        "summary": "Ambil profil dari token dummy (Body JSON)",
        "description": "Alternatif POST mengirim token pada body JSON, mengikuti format POST /api/auth/whoami. Hanya aktif di local dari localhost atau di development dengan IP allowlist; production menolak endpoint ini.",
        "tags": ["Dummy"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token"],
                "properties": {
                  "token": {
                    "type": "string",
                    "description": "JWT yang didapat dari /api/auth/login-dummy"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Data pegawai"
          },
          "401": {
            "description": "Token dummy tidak valid atau kedaluwarsa"
          },
          "403": {
            "description": "Token tidak sesuai aplikasi atau akun tidak aktif"
          },
          "404": {
            "description": "Endpoint dinonaktifkan, bukan environment yang diizinkan, atau IP tidak di-allowlist"
          }
        }
      }
    },
    "/api/simpeg/pegawai/status": {
      "post": {
        "summary": "Ubah status login pegawai",
        "description": "Mengubah status login SSO dan mengembalikan nama pegawai. Dapat dipanggil oleh aplikasi aktif mana pun yang sudah terdaftar menggunakan App dan X-App-Token yang cocok.",
        "tags": ["SIMPEG"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["id_peg", "status"],
                "properties": {
                  "id_peg": {
                    "type": "string",
                    "maxLength": 12,
                    "example": "102-119"
                  },
                  "status": {
                    "type": "string",
                    "enum": ["0", "1", "non job"],
                    "example": "non job",
                    "description": "0 atau non job memblokir login; 1 mengaktifkan kembali."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status berhasil diubah",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "Status login pegawai berhasil diperbarui.",
                  "data": {
                    "id_peg": "102-119",
                    "nama": "Nama Pegawai",
                    "status": "non job",
                    "can_login": false
                  }
                }
              }
            }
          },
          "401": {
            "description": "App dan X-App-Token wajib valid"
          },
          "403": {
            "description": "Aplikasi tidak terdaftar, token tidak valid, atau aplikasi tidak aktif"
          },
          "422": {
            "description": "ID akun tidak ditemukan atau status tidak valid"
          }
        }
      }
    },
    "/api/auth/whoami": {
      "get": {
        "summary": "Ambil data user dari token (Bearer)",
        "tags": ["Auth"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": [],
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Data user",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "OK",
                  "data": {
                    "employee_id": "102-119",
                    "full_name": "Nama Pegawai",
                    "branch_name": "Kantor Cabang",
                    "job_position": "Staff"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token tidak valid / expired"
          }
        }
      },
      "post": {
        "summary": "Ambil data user dari token (Body JSON)",
        "security": [
          {
            "appTokenAuth": [],
            "appCode": []
          }
        ],
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token"],
                "properties": {
                  "token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Data user"
          },
          "401": {
            "description": "Token tidak valid / expired"
          }
        }
      }
    },
    "/api/auth/change-password": {
      "post": {
        "summary": "Ganti Password (Perlu Login)",
        "tags": ["Profile"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": [],
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["old_password", "new_password"],
                "properties": {
                  "old_password": {
                    "type": "string",
                    "minLength": 6,
                    "example": "<PASSWORD_PEGAWAI>"
                  },
                  "new_password": {
                    "type": "string",
                    "minLength": 6,
                    "maxLength": 255,
                    "example": "BkkBaru2026!",
                    "description": "Password baru minimal 6 karakter"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password berhasil diubah"
          },
          "400": {
            "description": "Password lama salah atau password baru minimal 6 karakter"
          },
          "401": {
            "description": "Token tidak valid / expired"
          }
        }
      }
    },
    "/api/auth/update-profile": {
      "post": {
        "summary": "Update Email atau Nomor Telp (Perlu Login)",
        "tags": ["Profile"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": [],
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "pegawai_bkk@gmail.com"
                  },
                  "telp": {
                    "type": "string",
                    "example": "081234567890"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Data Profil berhasil diperbarui!"
          },
          "400": {
            "description": "Minimal kirim email atau telp"
          },
          "401": {
            "description": "Token tidak valid / expired"
          }
        }
      }
    },
    "/api/auth/forgot-password": {
      "post": {
        "summary": "Kirim OTP Reset Password ke Email",
        "tags": ["Reset Password"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "pegawai_bkk@gmail.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Kode OTP berhasil dikirim, mengembalikan otp_token sementara"
          },
          "400": {
            "description": "Email wajib diisi"
          },
          "404": {
            "description": "Email tidak terdaftar di sistem"
          },
          "500": {
            "description": "Gagal mengirim email OTP (Error Mailer)"
          }
        }
      }
    },
    "/api/auth/resend-otp": {
      "post": {
        "summary": "Kirim ulang OTP Reset Password ke Email",
        "description": "Gunakan endpoint ini jika OTP sebelumnya belum diterima atau sudah kadaluarsa. Token OTP baru akan dikembalikan.",
        "tags": ["Reset Password"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "pegawai_bkk@gmail.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP baru berhasil dikirim, mengembalikan otp_token sementara"
          },
          "400": {
            "description": "Email wajib diisi"
          },
          "404": {
            "description": "Email tidak terdaftar di sistem"
          },
          "500": {
            "description": "Gagal mengirim email OTP (Error Mailer atau akun SMTP suspended)"
          }
        }
      }
    },
    "/api/auth/verify-otp": {
      "post": {
        "summary": "Verifikasi Kode OTP dari Email",
        "tags": ["Reset Password"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["otp_token", "otp_code"],
                "properties": {
                  "otp_token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIs...",
                    "description": "Token yang didapat dari response /forgot-password atau /resend-otp"
                  },
                  "otp_code": {
                    "type": "string",
                    "example": "123456",
                    "description": "6 digit kode OTP dari email"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP Valid, mengembalikan reset_token"
          },
          "400": {
            "description": "Kode OTP salah"
          },
          "401": {
            "description": "Sesi OTP tidak valid atau sudah kadaluarsa (lebih dari 5 menit)"
          }
        }
      }
    },
    "/api/auth/reset-password": {
      "post": {
        "summary": "Aksi Ubah Password via Reset Token",
        "tags": ["Reset Password"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["reset_token", "new_password"],
                "properties": {
                  "reset_token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIs...",
                    "description": "Token yang didapat dari response /verify-otp"
                  },
                  "new_password": {
                    "type": "string",
                    "minLength": 6,
                    "maxLength": 255,
                    "example": "BkkBaru2026!",
                    "description": "Password baru minimal 6 karakter"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password berhasil di-reset"
          },
          "400": {
            "description": "Token reset wajib diisi dan password baru minimal 6 karakter"
          },
          "401": {
            "description": "Sesi reset password tidak valid atau sudah kadaluarsa (lebih dari 15 menit)"
          }
        }
      }
    },
    "/api/auth/admin-reset-password": {
      "post": {
        "summary": "Reset Password oleh Admin (Tanggal Lahir)",
        "description": "Admin mengirim id_peg. Password sementara diatur dari kolom tgl_lhr di tb_pegawai dengan format ddmmyy. Gunakan App dan X-App-Token yang cocok dari aplikasi aktif mana pun yang sudah terdaftar di Registry.",
        "tags": ["Reset Password"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["id_peg"],
                "properties": {
                  "id_peg": {
                    "type": "string",
                    "maxLength": 12,
                    "pattern": "^[A-Za-z0-9._-]+$",
                    "example": "102-119",
                    "description": "ID pegawai yang password akunnya akan direset."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password sementara berhasil diatur",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "Password sementara pegawai Nama Pegawai berhasil direset ke tanggal lahir format ddmmyy.",
                  "data": {
                    "id_peg": "102-119",
                    "nama": "Nama Pegawai",
                    "temporary_password": "010180",
                    "password_format": "ddmmyy",
                    "can_login": true
                  }
                }
              }
            }
          },
          "400": {
            "description": "ID pegawai tidak valid"
          },
          "403": {
            "description": "Aplikasi tidak terdaftar, token tidak valid, atau aplikasi tidak aktif"
          },
          "404": {
            "description": "Akun login atau data pegawai tidak ditemukan"
          },
          "422": {
            "description": "Tanggal lahir pegawai belum tersedia atau tidak valid"
          },
          "500": {
            "description": "Password sementara tidak dapat diproses"
          }
        }
      }
    },
    "/api/simpeg/ao/list": {
      "get": {
        "summary": "Ambil daftar AO SIMPEG berdasarkan type_ao dan kode kantor",
        "description": "Jika kode_kantor bernilai 000, data AO diambil dari kantor 001 sampai 028.",
        "tags": ["SIMPEG"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": [],
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "type_ao",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["dana", "kredit", "remedial"]
            },
            "description": "Jenis Account Officer: dana, kredit, atau remedial"
          },
          {
            "in": "query",
            "name": "kode_kantor",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Kode kantor. Gunakan 000 untuk mengambil AO dari kantor 001 sampai 028.",
            "example": "000"
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil mengambil data AO",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "Berhasil mengambil data AO DANA",
                  "data": [
                    {
                      "employee_id": "123-456",
                      "full_name": "Syaifun Nadhif Maulana",
                      "kode_cabang": "000",
                      "branch_name": "Kantor Pusat",
                      "job_position": "AO Dana"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Parameter 'type_ao' atau kode kantor wajib diisi; type_ao harus dana, kredit, atau remedial"
          },
          "401": {
            "description": "Token tidak valid / expired"
          }
        }
      }
    },
    "/api/simpeg/pegawai/search": {
      "get": {
        "summary": "Cari data pegawai berdasarkan id_peg atau nama",
        "description": "Cari pegawai berdasarkan id_peg atau sebagian nama. Endpoint memakai app token dan mengembalikan field ringkas yang konsisten dengan whoami.",
        "tags": ["SIMPEG"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "id_peg",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "ID pegawai yang ingin dicari",
            "example": "102-119"
          },
          {
            "in": "query",
            "name": "nama",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Sebagian atau seluruh nama pegawai",
            "example": "Nama Pegawai"
          }
        ],
        "responses": {
          "200": {
            "description": "Data pegawai ditemukan",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "OK",
                  "data": [
                    {
                      "employee_id": "102-119",
                      "full_name": "Nama Pegawai",
                      "kode": "001",
                      "job_position": "Staf"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Minimal salah satu parameter id_peg atau nama wajib diisi"
          }
        }
      }
    },
    "/api/simpeg/jabatan": {
      "get": {
        "summary": "Daftar master jabatan SIMPEG",
        "description": "Mengembalikan semua master jabatan termasuk posisi yang belum terisi, digabung dengan penempatan berstatus Aktif. Satu baris diberikan untuk setiap pemegang aktif; posisi kosong tetap muncul dengan field penempatan bernilai null. Kode jabatan dan relasi jabatan dikirim sebagai string. Tabel master belum menyediakan kolom waktu perubahan; gunakan pagination dan sinkronkan seluruh halaman.",
        "tags": ["SIMPEG"],
        "security": [
          {
            "appTokenAuth": [],
            "appCode": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          },
          {
            "in": "query",
            "name": "per_page",
            "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 100 }
          }
        ],
        "responses": {
          "200": {
            "description": "Daftar master jabatan",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "OK",
                  "data": [
                    {
                      "kode_jabatan": "79",
                      "nama_jabatan": "Kepala Kantor Wilayah",
                      "nama_unit_kerja": "Area Kantor Wilayah",
                      "level": "Kepala Kantor Wilayah",
